{
  "name": "herebound",
  "version": "0.2.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "export": "expo export --platform android --max-workers 2"
  },
  "dependencies": {
    "expo": "~55.0.31",
    "expo-location": "~55.1.14",
    "expo-sqlite": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "expo-file-system": "~55.0.26",
    "expo-sharing": "~55.0.24",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-svg": "15.15.3",
    "expo-camera": "~55.0.23",
    "@maplibre/maplibre-react-native": "11.5.0"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules",
      "searchPaths": [
        "../../node_modules"
      ],
      "exclude": [
        "trakk-coach",
        "trakk-ar",
        "expo-dev-client",
        "expo-speech",
        "expo-task-manager"
      ],
      "android": {
        "buildFromSource": [
          "expo-camera"
        ]
      }
    }
  }
}
