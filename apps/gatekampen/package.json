{
  "name": "gatekampen",
  "version": "0.1.3",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "export": "expo export --platform android --max-workers 2"
  },
  "dependencies": {
    "@maplibre/maplibre-react-native": "11.5.0",
    "expo": "~55.0.31",
    "expo-location": "~55.1.14",
    "expo-secure-store": "~55.0.14",
    "expo-sqlite": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "expo-task-manager": "~55.0.20",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-svg": "15.15.3"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules",
      "searchPaths": [
        "../../node_modules"
      ],
      "exclude": [
        "trakk-coach",
        "trakk-ar",
        "herebound-ar",
        "expo-dev-client",
        "expo-speech",
        "expo-camera"
      ],
      "android": {
        "buildFromSource": [
          "expo-location"
        ]
      }
    }
  }
}
