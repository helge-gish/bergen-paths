{
  "expo": {
    "name": "Tråkk",
    "slug": "trakk",
    "platforms": [
      "android",
      "ios"
    ],
    "version": "0.4.8",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "trakk",
    "icon": "./assets/trakk-icon.png",
    "ios": {
      "bundleIdentifier": "no.trakk.app",
      "supportsTablet": false
    },
    "android": {
      "package": "no.trakk.app",
      "versionCode": 42,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/trakk-icon.png",
        "backgroundColor": "#183D32"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "@maplibre/maplibre-react-native",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Tråkk bruker posisjonen din til å tegne turen og finne stier i nærheten.",
          "locationAlwaysAndWhenInUsePermission": "Tråkk registrerer turen også når skjermen er låst. Registreringen stopper når du velger Avslutt tur.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Tråkk bruker kameraet til å vise retningen til stier rundt deg. Ingen bilder lagres.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ]
    ]
  }
}
